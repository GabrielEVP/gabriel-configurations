{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Monokai Gentleman Kanagawa",
  "author": "Gemini",
  "themes": [
    {
      "name": "Monokai Gentleman Kanagawa",
      "appearance": "dark",
      "style": {
        "background.appearance": "blurred",
        "background": "#1f1f2855",
        "status_bar.background": "#16161D85",
        "title_bar.background": "#16161D85",
        "toolbar.background": "#2A2A3785",
        "tab_bar.background": "#16161D85",
        "tab.inactive_background": "#1F1F2885",
        "tab.active_background": "#2A2A3785",
        "panel.background": "#1F1F2885",
        "editor.background": "#1F1F2855",
        "editor.gutter.background": "#2A2A3785",
        "terminal.background": "#1F1F28",
        "border": "#E0C15A00",
        "border.variant": "#FFE06600",
        "border.focused": "#FFE066FF",
        "border.selected": "#FFE066FF",
        "border.transparent": "#FFE066FF",
        "border.disabled": "#FFE066FF",
        "elevated_surface.background": "#15192AFF",
        "surface.background": "#191E28d0",
        "element.background": "#232A40FF",
        "element.hover": "#8AD6FF4d",
        "element.active": "#FF8DD700",
        "element.selected": "#263356CC",
        "element.disabled": "#313342FF",
        "text": "#F3F6F9FF",
        "text.muted": "#5C6170FF",
        "text.placeholder": "#8A8FA3FF",
        "text.disabled": "#606C86FF",
        "text.accent": "#E0C15AFF",
        "icon": "#F3F6F9FF",
        "icon.muted": "#A2B2C1FF",
        "icon.disabled": "#8A8FA3FF",
        "icon.placeholder": "#8A8FA3FF",
        "icon.accent": "#FF8DD7FF",
        "editor.foreground": "#F3F6F9FF",
        "editor.active_line.background": "#8AD6FF1A",
        "editor.highlighted_line.background": "#FFE06612",
        "editor.line_number": "#8AD6FF40",
        "editor.active_line_number": "#DEBA8790",
        "syntax": {
          "attribute": { "color": "#A6E22E" },
          "boolean": { "color": "#AE81FF" },
          "comment": { "color": "#75715E", "font_style": "italic" },
          "constant": { "color": "#AE81FF" },
          "constructor": { "color": "#A6E22E" },
          "function": { "color": "#E6DB74", "font_style": "italic" },
          "keyword": { "color": "#F92672" },
          "number": { "color": "#AE81FF" },
          "operator": { "color": "#F92672" },
          "property": { "color": "#A6E22E" },
          "punctuation": { "color": "#F8F8F2" },
          "string": { "color": "#E6DB74" },
          "tag": { "color": "#F92672" },
          "title": { "color": "#E6DB74", "font_weight": 800 },
          "type": { "color": "#66D9EF", "font_style": "italic" },
          "variable": { "color": "#F8F8F2" }
        }
      }
    }
  ]
}